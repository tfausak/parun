{
  "description": "CR 603.2c Coalhauler Swine reads a double block's total once",
  "note": "Coalhauler Swine is blocked by a 2/1 and a 1/1, so CR 510.2 deals it two damage events at once. Per its rulings (Ripjaw Raptor's, Fungusaur's) that is ONE trigger reading the batch's total: each player loses 3. A trigger per event costs each player 2 and 1, the same 3, but asks alice to order two triggers, which this script never answers; a batch trigger reading only its first event costs 2. The 3 marked on the Swine is the precondition: both blockers' damage landed.",
  "board": {
    "seats": [
      {
        "name": "alice",
        "battlefield": [{ "card": "Coalhauler Swine", "label": "swine", "ready": true }]
      },
      {
        "name": "bob",
        "battlefield": [
          { "card": "Goblin Piker", "label": "piker", "ready": true },
          { "card": "Prodigal Sorcerer", "label": "sorcerer", "ready": true }
        ]
      }
    ],
    "active": "alice",
    "step": "DeclareAttackers"
  },
  "timeline": [
    { "turn": 1, "step": "DeclareAttackers", "player": "alice", "do": { "Attack": ["$swine"] } },
    { "turn": 1, "step": "DeclareAttackers", "player": "alice", "check": { "Life": { "player": "alice", "life": 20 } } },
    { "turn": 1, "step": "DeclareAttackers", "player": "alice", "check": { "Life": { "player": "bob", "life": 20 } } },
    { "turn": 1, "step": "DeclareBlockers", "player": "bob", "do": { "Block": { "$piker": ["$swine"], "$sorcerer": ["$swine"] } } },
    { "turn": 1, "step": "CombatDamage", "player": "alice", "source": "$swine", "do": { "AssignDamage": { "$piker": 2, "$sorcerer": 2 } } },
    { "turn": 1, "step": "EndOfCombat", "player": "alice", "check": { "Life": { "player": "alice", "life": 17 } } },
    { "turn": 1, "step": "EndOfCombat", "player": "alice", "check": { "Life": { "player": "bob", "life": 17 } } },
    { "turn": 1, "step": "EndOfCombat", "player": "alice", "check": { "Damage": { "object": "$swine", "damage": 3 } } }
  ]
