cabal-version: 3.0
-- cabal-gild: version
-- Generated with cabal-gild version 1.8.4.2
name: parun
version: 0.2026.10.28
synopsis: Magic: The Gathering rules engine
description:
  Parun is a Magic: The Gathering rules engine.

category: Game
license: 0BSD
maintainer: Taylor Fausak
license-file: LICENSE.txt
data-dir: data
data-files:
  cards/*.json
  decks/*.txt
  decks/sets/*.txt
  oracle-unrendered.txt
  scenarios/**/*.json
  sticker-sheets/*.json

extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  location: https://github.com/tfausak/parun
  type: git

flag pedantic
  default: False
  manual: True

common library
  build-depends: base ^>={4.20.2, 4.21.1, 4.22.0}
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-deriving-strategies
    -Wno-missing-export-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-role-annotations
    -Wno-missing-safe-haskell-mode
    -Wno-prepositive-qualified-module
    -Wno-safe
    -Wno-unsafe

  if flag(pedantic)
    ghc-options: -Werror

common executable
  import: library
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts=-A64m
    -with-rtsopts=-N

-- The benchmark suite. The `parun-benchmark` target is a thin wrapper around it.
library benchmark
  import: library
  build-depends:
    containers ^>={0.7, 0.8},
    parun:engine,
    parun:registry,
    parun:types,
    tasty-bench ^>={0.4.1, 0.5.1},

  hs-source-dirs: source/libraries/benchmark
  -- cabal-gild: discover source/libraries/benchmark
  exposed-modules:
    Parun.Benchmark

-- A JSON codec for each type.
library codec
  import: library
  build-depends:
    containers ^>={0.7, 0.8},
    parun:json,
    parun:json-codec,
    parun:json-schema,
    parun:spec,
    parun:types,
    text ^>=2.1.3,

