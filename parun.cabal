-- URI components, and the encoding each of them takes.
library uri
  import: library
  build-depends:
    bytestring ^>=0.12.2,
    parun:extra,
    parun:spec,

  hs-source-dirs: source/libraries/uri
  -- cabal-gild: discover source/libraries/uri
  exposed-modules:
    Parun.Uri.Fragment
    Parun.Uri.FragmentSpec

executable parun
  import: executable
  build-depends: parun:executable
  hs-source-dirs: source/executable
  main-is: Main.hs

test-suite parun-test-suite
  import: executable
  build-depends: parun:test
  hs-source-dirs: source/test-suite
  main-is: Main.hs
  type: exitcode-stdio-1.0

benchmark parun-benchmark
  import: executable
  build-depends: parun:benchmark
  hs-source-dirs: source/benchmark
  main-is: Main.hs
  type: exitcode-stdio-1.0
